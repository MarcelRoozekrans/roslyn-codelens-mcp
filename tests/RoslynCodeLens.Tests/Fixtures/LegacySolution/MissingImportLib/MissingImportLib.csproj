<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Fixture for the scenario from issue 175: a legacy project that imports a Visual Studio only targets file.
    Roslyn's design-time build ignores the missing import, so the project still evaluates its Compile items.
    The framework version below has no targeting pack on any machine, so the framework references never
    resolve, as on a machine without the net48 targeting pack. The loader must report the project as skipped.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <TargetFrameworkVersion>v9.9</TargetFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MissingImportLib.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v99.0\WebApplications\Microsoft.WebApplication.targets" />
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
